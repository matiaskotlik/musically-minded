{
  "name": "@repo/backend",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo/cache dist node_modules",
    "dev": "tsx watch src",
    "format": "prettier --write --ignore-path ../../.gitignore --cache --cache-location .cache/.prettiercache",
    "format:check": "prettier --check --ignore-path ../../.gitignore --cache --cache-location .cache/.prettiercache",
    "lint": "expo lint --fix -- --cache-location .cache/.eslintcache",
    "lint:check": "expo lint -- --cache-location .cache/.eslintcache"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "supabase": "^2.39.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.12.1"
}
